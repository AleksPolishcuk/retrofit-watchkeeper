# Copy to .env and fill in. Never commit .env. Keys are used on the backend only, never in browser code.
# Every integration is optional: the core pipeline must run without any of them.

# Google AI Studio (Gemini). Used only to word explanations from already computed evidence.
GEMINI_API_KEY=

# ElevenLabs. Used only for demo narration.
ELEVENLABS_API_KEY=

# n8n human-approval workflow webhook (draft work order, no machine control).
N8N_WEBHOOK_URL=
